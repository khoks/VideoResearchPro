# Pratidhvani environment template. The only one in the repository.
#
# Copy to backend/.env and fill in values:
#   cd backend && cp ../.env.example .env
#
# Every Settings field in backend/app/config.py is listed here with its default,
# in the groups of CLAUDE.md's "Environment Variables" table, and a backend test
# fails when the two drift (backend/tests/test_ci/test_docs_match_code.py).
# Commented lines show the default; uncomment and edit to override. Secrets are
# blank. The required ones are YOUTUBE_API_KEY and the key of your LLM provider.

# ===== App and infrastructure =====
# APP_NAME=Pratidhvani
# DEBUG=false
# DATABASE_URL=sqlite:///./data/videoresearchpro.db
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Links in emails (saved-search alerts) point here.
# APP_BASE_URL=http://localhost:5173

# ===== YouTube =====
YOUTUBE_API_KEY=
# YOUTUBE_DAILY_QUOTA=10000
# YOUTUBE_SEARCH_MAX_PAGES=2

# ===== Transcript-pipeline resilience (E-1.11 / D-051) =====
# YOUTUBE_TRANSCRIPT_RATE_LIMIT=3.0
# YOUTUBE_TRANSCRIPT_RATE_JITTER=0.4
# TRANSCRIPT_BREAKER_THRESHOLD=3
# TRANSCRIPT_BREAKER_COOLDOWN_BASE=120.0
# TRANSCRIPT_BREAKER_COOLDOWN_MAX=900.0
# TRANSCRIPT_BREAKER_MAX_WAIT=300.0
# WHISPER_SEGMENT_TARGET_MB=20
# WHISPER_SEGMENT_OVERLAP_SECONDS=15.0
# Max Whisper transcriptions per job, subscription jobs included; 0 disables
# Whisper. What it stops stays unavailable, and the next sync tries it.
# WHISPER_MAX_PER_JOB=50
# Minutes of audio per job, counted from each recording's whole length. Once
# spent, no further recording goes to Whisper. 0 = no minute cap.
# WHISPER_MAX_MINUTES_PER_JOB=0
# Proxy for the transcript API and yt-dlp, for IP blocks: http://... or socks5://...
# YOUTUBE_PROXY_URL=
# yt-dlp cookies for YouTube's bot wall. The browser source (chrome, firefox,
# chrome:Profile) is an explicit opt-in: requests then carry that account.
# YTDLP_COOKIES_FROM_BROWSER=
# YTDLP_COOKIES_FILE=
# YTDLP_DOWNLOAD_RATE_LIMIT=2.0

# ===== Other sources =====
# Reddit (S-1.5.1): read-only script-app OAuth. Register at
# https://www.reddit.com/prefs/apps. USER_AGENT must follow Reddit's format:
# <platform>:<app-id>:<version> (by /u/<username>).
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=pratidhvani/0.1 (by u/anonymous)
# REDDIT_RATE_LIMIT_RPM=100
# REDDIT_COMMENT_DEPTH_DEFAULT=50
# Hacker News, Mastodon and Bluesky: public APIs, no keys.
# HN_USER_AGENT=pratidhvani/0.1 (+https://github.com/anthropics/pratidhvani)
# HN_RATE_LIMIT_RPM=60
# HN_COMMENT_DEPTH_DEFAULT=50
# Blank, the form stops offering Mastodon and POST /jobs refuses it.
# MASTODON_INSTANCE_BASE=https://mastodon.social
# MASTODON_USER_AGENT=pratidhvani/0.1 (+https://github.com/anthropics/pratidhvani)
# MASTODON_RATE_LIMIT_RPM=60
# MASTODON_COMMENT_DEPTH_DEFAULT=50
# Not public.api.bsky.app, whose CDN refuses searchPosts. Blank, as for Mastodon.
# BLUESKY_XRPC_BASE=https://api.bsky.app
# BLUESKY_USER_AGENT=pratidhvani/0.1 (+https://github.com/anthropics/pratidhvani)
# BLUESKY_RATE_LIMIT_RPM=60
# BLUESKY_COMMENT_DEPTH_DEFAULT=50
# Podcasts: iTunes search plus each show's RSS feed.
# PODCAST_USER_AGENT=pratidhvani/0.1 (+https://github.com/anthropics/pratidhvani)
# PODCAST_RATE_LIMIT_RPM=60
# PODCAST_EPISODES_PER_SHOW=5
# PODCAST_SEARCH_TOP_N_SHOWS=3
# PODCAST_AUDIO_FETCH_TIMEOUT_SEC=180
# Web articles. Search needs a Brave key. The Playwright fallback for script-heavy
# pages is an opt-in install: pip install -r backend/requirements-spa.txt, then
# playwright install chromium.
BRAVE_SEARCH_API_KEY=
# BRAVE_SEARCH_BASE=https://api.search.brave.com/res/v1/web/search
# ARTICLE_USER_AGENT=pratidhvani/0.1 (+https://github.com/anthropics/pratidhvani)
# ARTICLE_SEARCH_RATE_LIMIT_RPM=60
# ARTICLE_PLAYWRIGHT_ENABLED=false
# ARTICLE_PLAYWRIGHT_TIMEOUT_SEC=30
# X / Twitter: BYOK paid API (D-009). Unset, tweets come by pasted URL only.
# TWITTER_BEARER_TOKEN=
# TWITTER_API_BASE=https://api.twitter.com/2
# TWITTER_USER_AGENT=pratidhvani/0.1 (+https://github.com/anthropics/pratidhvani)
# TWITTER_RATE_LIMIT_RPM=60
# Not read by any code yet: reserved for the reply fetch S-1.5.10 still owes.
# TWITTER_REPLY_DEPTH_DEFAULT=50
# PDF uploads.
# PDF_UPLOAD_DIR=./data/uploads/pdf
# PDF_MAX_BYTES=104857600

# ===== RAG and ChromaDB =====
# CHROMA_PERSIST_DIR=./data/chroma
# CHROMA_GLOBAL_COLLECTION_NAME=pratidhvani_global
# CHROMA_QA_COLLECTION_NAME=qa_library_global
# CHROMA_NOTES_COLLECTION_NAME=notes_global
# CHROMA_SHARES_COLLECTION_NAME=shares_global
# CHROMA_PERSONAL_CONTEXT_COLLECTION_NAME=personal_context_global
# CHUNK_SIZE=256
# CHUNK_OVERLAP=32
# RAG_TOP_K=15
# RAG_DISTANCE_THRESHOLD=0.6
# EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
# NOTES_INDEX_ENABLED=true
# NOTE_RETRIEVAL_WEIGHT=1.5

# ===== Jobs, reports and knowledge =====
# Active jobs ONE user may hold at once, each user counted alone. That user's
# next job is refused; nobody else's is affected. The install's total is not
# limited: past what the worker can run, a job waits in the queue, whoever's it
# is. This also sets a prefork worker's pool size; --pool=solo runs one task at
# a time regardless.
# MAX_CONCURRENT_JOBS=5
# DEFAULT_TRANSCRIPT_LANGUAGE=en
# REPORTS_DIR=./data/reports
# REPORT_INTERMEDIATES_ENABLED=true
# Map-stage batching (S-1.14.19, D-094): packed | source.
# REPORT_MAP_BATCHING=packed
# REPORT_MAP_BATCH_TOKENS=120000
# REPORT_MAP_CONCURRENCY=4
# REPORT_ATTRIBUTION_GUARD_ENABLED=true
# KNOWLEDGE_EXTRACT_BATCH_TOKENS=8000
# KNOWLEDGE_MAX_TRANSCRIPT_TOKENS=60000

# ===== Author Studio =====
# Book PDF converter (S-6.1.5): auto | weasyprint | chromium | off. Optional install:
# pip install -r backend/requirements-author.txt (WeasyPrint needs Pango; Chromium
# needs `playwright install chromium`).
# OUTPUTS_DIR=./data/outputs
# AUTHOR_PDF_ENGINE=auto
# AUTHOR_PDF_TIMEOUT_SEC=180

# ===== Saved searches, notifications and suggestions =====
# Saved-search change detection (S-8.3.3): pre-registered priors, calibration pending
# (docs/notes/2026-10-19-saved-search-change-thresholds.md).
# SAVED_SEARCH_JACCARD_THRESHOLD=0.5
# SAVED_SEARCH_EMBEDDING_THRESHOLD=0.15
# SAVED_SEARCH_GATE_ENABLED=true
# Publish each new notification on Redis so an open bell updates at once;
# the bell's one-minute poll is the fallback.
# NOTIFICATIONS_PUSH_ENABLED=true
# Minutes a context's "You might ask" list is reused before recomputing.
# SUGGESTIONS_CACHE_TTL_MIN=60

# ===== Scheduler (S-8.3.1 / M3) =====
# One Celery beat process fires `scheduler.tick` every SCHEDULER_TICK_SECONDS; the
# tick dispatches due `scheduled_runs` rows (saved searches, newsletter, Echo syncs).
# SCHEDULER_ENABLED=true
# SCHEDULER_TICK_SECONDS=300
# SCHEDULER_LEASE_SECONDS=600
# SCHEDULER_GRACE_SECONDS=30
# SCHEDULER_BATCH_SIZE=50
# SCHEDULER_MAX_RETRY_TICKS=3

# ===== Usage metering (E-5.2) =====
# How often, in seconds, an open metering scope writes what it has counted, so a worker
# that dies mid-task loses about this much of its usage. 0 = only when the scope closes.
# USAGE_FLUSH_INTERVAL_SECONDS=60

# ===== Visual understanding (R1 / E-1.18) =====
# Off by default, and each job must opt in too. R1 is parked (D-109).
# VISUAL_ENABLED=false
# VISUAL_FRAMES_DIR=./data/frames
# VISUAL_MAX_FRAMES_PER_VIDEO=12
# VISUAL_MAX_FRAMES_PER_JOB=200
# VISUAL_MIN_GAP_SECONDS=20.0
# VISUAL_FRAME_MAX_WIDTH=1280
# VISUAL_FRAME_JPEG_QUALITY=5
# VISUAL_MAX_VIDEO_DOWNLOAD_MB=400
# VISUAL_CAPTURE_TIMEOUT_SEC=900

# ===== Temporal awareness (R3 / E-1.17) =====
# TEMPORAL_SCOPE_ENABLED=true
# TEMPORAL_SCOPE_WINDOW_TOKENS=1500

# ===== Code-mixed speech (R5 / N-002 / D-080) =====
# CODE_MIX_DOMINANT_SHARE=0.6
# CODE_MIX_ENGLISH_RENDERING_ENABLED=true
# CODE_MIX_BORROWING_MAX_SHARE=0.2

