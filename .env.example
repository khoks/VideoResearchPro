# App
DEBUG=true

# Database
DATABASE_URL=sqlite:///./data/videoresearchpro.db

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# YouTube
YOUTUBE_API_KEY=your-youtube-api-key-here

# Reddit (S-1.5.1) — read-only access via script-app OAuth.
# Register a script app at https://www.reddit.com/prefs/apps to obtain
# CLIENT_ID + CLIENT_SECRET. USER_AGENT must follow Reddit's required
# format `<platform>:<app-id>:<version> (by /u/<username>)`.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=pratidhvani/0.1 (by u/anonymous)
REDDIT_RATE_LIMIT_RPM=100
REDDIT_COMMENT_DEPTH_DEFAULT=50

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
LLM_MODEL=gpt-5.4

# ChromaDB
CHROMA_PERSIST_DIR=./data/chroma

# Reports
REPORTS_DIR=./data/reports
# Author Studio artifacts (S-6.7.2): <OUTPUTS_DIR>/<user_id>/<output_id>/
OUTPUTS_DIR=./data/outputs
# Book PDF converter (S-6.1.5): auto | weasyprint | chromium | off.
# Optional install: pip install -r backend/requirements-author.txt
# (WeasyPrint needs Pango; Chromium needs `playwright install chromium`).
AUTHOR_PDF_ENGINE=auto
AUTHOR_PDF_TIMEOUT_SEC=180

# Scheduler (S-8.3.1 / M3) — one Celery beat process fires `scheduler.tick`
# every SCHEDULER_TICK_SECONDS; the tick dispatches due `scheduled_runs`
# rows (saved searches, newsletter, Echo syncs). Set SCHEDULER_ENABLED=false
# to register no beat entry; a tick that still arrives then no-ops.
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=300
