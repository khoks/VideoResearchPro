# ===== Echo signal extraction (S-3.3.2 / D-099) =====
# ECHO_SIGNAL_EXTRACTION=celery
# ECHO_SIGNALS_MIN_NEW_INPUTS=10
# ECHO_SIGNALS_BATCH_TOKENS=6000
# ECHO_SIGNALS_MAX_PER_BATCH=12
# ECHO_SIGNALS_MAX_OUTPUT_TOKENS=2500
# ECHO_SIGNALS_MAX_BATCHES_PER_RUN=20
