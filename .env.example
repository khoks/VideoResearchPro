# ===== Speak as me (S-3.4.1 / D-102) =====
# ECHO_SPEAK_AS_ME_ENABLED=false
# ECHO_DRAFT_CRITIQUE_ROUNDS=2
# ECHO_DRAFT_CRITIQUE_TARGET=4.0
# ECHO_DRAFT_SOURCES=6
# ECHO_VOICE_TEST_GENERATION=celery
# ECHO_VOICE_TESTS_PER_DAY=3
# ECHO_PERSONAL_INDEX_ENABLED=true

# ===== LLM providers and routing =====
# Set the key of every provider your resolved use cases point at. The defaults
# point at openai, so OPENAI_API_KEY is required out of the box.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Per-use-case override: comma-separated use_case=provider:model[:reasoning], with
# provider one of openai, anthropic, google, local and reasoning one of off, minimal,
# low, medium, high, auto. Unknown entries log a warning and are ignored, never fatal.
# Every use case and its default: the /account/ai-models page, or USE_CASE_REGISTRY in
# backend/app/services/llm_routing.py.
# For instance: LLM_USE_CASE_CONFIG=qa_clarification=local:qwen3-8b:off,report_compose=google:gemini-2.5-pro
# LLM_USE_CASE_CONFIG=
# Any OpenAI-compatible server (LM Studio, Ollama, vLLM, llama.cpp-server), used when a
# use case resolves to provider=local, e.g. http://localhost:1234/v1. Most servers
# ignore the key, but the OpenAI SDK needs a non-empty one: unset, it falls back to
# LLM_FAST_API_KEY, whose default is not-needed.
# LLM_LOCAL_BASE_URL=
# LLM_LOCAL_API_KEY=

# ===== Legacy LLM knobs (deprecated) =====
# Still honored for back-compat. New work uses LLM_USE_CASE_CONFIG.
# LLM_ROUTE_OVERRIDES=
# LLM_PRIMARY_PROVIDER=openai
# LLM_PRIMARY_MODEL=
# LLM_MODEL=gpt-5
# LLM_FALLBACK_MODEL=gpt-4o
# LLM_FAST_MODEL=gpt-4.1-mini
# LLM_FAST_BASE_URL=
# LLM_FAST_API_KEY=

# ===== Auth =====
# CHANGE JWT_SECRET IN PRODUCTION. Blank falls back to an insecure development value.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
# JWT_ALGORITHM=HS256
# JWT_EXPIRY_HOURS=24
# LOCKOUT_FAILURE_THRESHOLD=5
# LOCKOUT_DURATION_MIN=15
# PASSWORD_RESET_TOKEN_TTL_MIN=30
# MFA_ISSUER_NAME=Pratidhvani
# Operators (T-5.2.8 / D-111): comma-separated, case-insensitive emails of the accounts
# allowed to switch tiers (PUT /auth/me/tier) and restart the services (POST /admin/restart).
# Leave empty on a single-user install: the earliest-registered account is then the
# operator. Name your operators on an install with several accounts.
# Register the account before listing it. Sign-up verifies no email, so password
# registration refuses a listed address (anyone could otherwise claim it); signing in with
# Google or GitHub with that address, verified by the provider, still works. Startup logs
# a warning for every listed address that has no account.
# ADMIN_EMAILS=

# ===== Email (SMTP) =====
# Unset: the password-reset email goes to the server log, for the operator to hand over.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=
# SMTP_USE_SSL=false
# SMTP_USE_STARTTLS=true

# ===== OAuth =====
# OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_GITHUB_CONNECTOR_CLIENT_ID=
OAUTH_GITHUB_CONNECTOR_CLIENT_SECRET=
# Not read by any code yet: reserved for the Google connectors (S-3.2.2, S-3.2.5).
# OAUTH_GOOGLE_CONNECTOR_CLIENT_ID=
# Not read by any code yet: reserved for the Google connectors (S-3.2.2, S-3.2.5).
OAUTH_GOOGLE_CONNECTOR_CLIENT_SECRET=

# ===== Rate limiting (E-5.5) =====
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_PER_MIN_FREE=60
# RATE_LIMIT_PER_MIN_PRO=600
# RATE_LIMIT_PER_MIN_STUDIO=6000
# RATE_LIMIT_PER_MIN_UNAUTH=100
# RATE_LIMIT_LOGIN_PER_MIN=10
# RATE_LIMIT_RESET_PER_MIN=5
# RATE_LIMIT_REGISTER_PER_MIN=5
# "Verify key" presses per user per minute; each is a paid request on their key.
# RATE_LIMIT_VERIFY_KEY_PER_MIN=5
# The reverse proxies whose X-Forwarded-For counts, as comma-separated IPs or
# CIDRs. Empty: the header is ignored and the caller is the socket peer. An
# install behind a proxy MUST set this, or every user shares one address and
# one per-IP limit (README, "Running behind a reverse proxy").
# TRUSTED_PROXY_IPS=

# ===== BYOK + MFA encryption (E-5.6 / E-5.4) =====
# Fernet key for stored provider keys, MFA secrets and connector tokens. Unset, a key is
# generated per process and what was stored cannot be read after a restart. Generate one:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BYOK_ENCRYPTION_KEY=

# ===== Frontend (Vite) =====
# Not read by the backend. Set them only when the API is somewhere else.
# The first two go in frontend/.env, which Vite loads into the app.
# Base URL of REST calls.
# VITE_API_BASE_URL=http://localhost:8000/api/v1
# Progress socket. Unset, /ws/jobs on the page's own host, which the dev server proxies.
# VITE_WS_URL=
# Where the dev server proxies /api and /ws. Set this one in the shell that runs
# `npm run dev`, never in frontend/.env: vite.config.ts reads process.env, which Vite
# does not fill from .env files, so a value there is ignored and /api still goes to 8000.
# VITE_PROXY_TARGET=http://localhost:8000
