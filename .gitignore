# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Virtual environment
backend/venv/
venv/
.venv/

# Environment variables
.env

# Data (runtime)
backend/data/
backend/data.legacy-backup.*/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Node
node_modules/
frontend/dist/

# Testing
.coverage
htmlcov/
.pytest_cache/

# Alembic
*.db

# Claude Code — root .claude/ is partially tracked: skills, hooks, and project settings
# are checked in; everything else (settings.local.json, worktrees/, launch.json, etc.) stays local.
/.claude/*
!/.claude/skills/
!/.claude/hooks/
!/.claude/settings.json
# Any nested .claude/ (e.g. backend/.claude/) stays fully ignored.
**/[!/].claude/
backend/.claude/

# Logs
backend/logs/
*.log
