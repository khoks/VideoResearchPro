# Pratidhvani — backend environment template
#
# Copy to `backend/.env` and fill in values. Every variable has a sane
# default in `app/config.py`; the only required vars are YOUTUBE_API_KEY
# and an API key for your primary LLM provider (OPENAI_API_KEY by
# default, or ANTHROPIC_API_KEY / GOOGLE_API_KEY if you flip providers).
# Commented lines show the built-in default; uncomment and edit to
# override. Secret and required vars are shown uncommented and blank.

# ===== App basics =====
# APP_NAME=Pratidhvani
# DEBUG=false
# DATABASE_URL=sqlite:///./data/videoresearchpro.db

# ===== Redis / Celery =====
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ===== ChromaDB =====
# CHROMA_PERSIST_DIR=./data/chroma
# CHROMA_GLOBAL_COLLECTION_NAME=pratidhvani_global
# CHROMA_QA_COLLECTION_NAME=qa_library_global

# ===== YouTube =====
YOUTUBE_API_KEY=
# YOUTUBE_TRANSCRIPT_RATE_LIMIT=0.5
# YOUTUBE_DAILY_QUOTA=10000

# ===== LLM providers (API keys) =====
# Fill in the key for whichever provider(s) you actually use. Only the
# key matching your resolved per-use-case provider is strictly required,
# but setting all three lets you switch providers with a config edit.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ===== LLM local endpoint =====
# For LM Studio / Ollama / vLLM / llama.cpp-server — any OpenAI-compatible endpoint.
# Used whenever a use case resolves to provider=local. If blank, the
# legacy LLM_FAST_BASE_URL / LLM_FAST_API_KEY values (below) are used.
# LLM_LOCAL_BASE_URL=http://localhost:1234/v1
# LLM_LOCAL_API_KEY=not-needed

# ===== LLM per-use-case config =====
# Format: comma-separated `use_case=provider:model[:reasoning]`.
#   provider  ∈ {openai, anthropic, google, local}
#   model     = provider-specific model id (any non-empty string for local)
#   reasoning ∈ {off, minimal, low, medium, high, auto}  (optional, default off)
#
# Missing use cases fall back to the registry default_config in
# app/services/llm_routing.py::USE_CASE_REGISTRY. Unknown names, providers,
# or reasoning levels log a warning and are ignored — never fatal.
#
# Use cases (with the registry default shown after the arrow):
#   Job Q&A pipeline (app/agents/qa_agent.py, app/routers/qa.py):
#     qa_clarification            → openai:gpt-5.4-mini:off
#         Short clarifying follow-up after the user asks about a job's videos.
#     qa_sub_query_expansion      → openai:gpt-5.4-mini:off
#         Rephrase the question into 2 focused sub-queries for RAG.
#     qa_refine_context           → openai:gpt-5.4:low
#         Compact top-K RAG hits + report context into a focused excerpt.
#     qa_formulate_answer         → openai:gpt-5.4:medium
#         Final user-facing answer with citations (temperature 0).
#     qa_extract_references       → openai:gpt-5.4-mini:off
#         Parse the answer into structured (video_id, timestamp, quote).
#   Library-wide Q&A (app/agents/qa_agent.py library path, app/routers/library.py):
#     library_qa_clarification    → openai:gpt-5.4-mini:off
#         qa_clarification, but across the whole library.
#     library_qa_refine_context   → openai:gpt-5.4:low
#         Compact library-wide RAG hits before the final answer.
#     library_qa_formulate_answer → openai:gpt-5.4:medium
#         Final library-wide answer with citations across videos.
#   Q&A History ("Personal Wiki" meta-chat) — app/agents/qa_history_agent.py:
#     qa_history_refine_context   → openai:gpt-5.4-mini:low
#         Compact retrieved past exchanges before the meta-answer.
#     qa_history_formulate_answer → openai:gpt-5.4:medium
#         Synthesize a meta-answer across past exchanges with citations.
#   Per-video Knowledge extraction — app/agents/knowledge_agent.py:
#     knowledge_extract_batch     → openai:gpt-5.4-mini:off
#         Map: extract {topics, concepts, events, facts} JSON from chunks.
#     knowledge_synthesize_report → openai:gpt-5.4:medium
#         Reduce: compose the Markdown knowledge report.
#   Topic search — app/agents/search_agent.py:
#     search_plan_queries         → openai:gpt-5.4-mini:low
#         Plan 3-5 YouTube search queries from the user's topic prompt.
#     search_rank_and_curate      → openai:gpt-5.4:high
#         Rank YouTube results and curate the final video list.
#   Report generation (map-reduce) — app/agents/report_agent.py:
#     report_map_chunks           → openai:gpt-5.4-mini:off
#         Map: extract key facts from each batch of transcript chunks.
#     report_reduce_summaries     → openai:gpt-5.4-mini:low
#         Reduce: consolidate per-batch summaries into one structured summary.
#     report_compose              → openai:gpt-5.4:medium
#         Compose the final HTML report from the reduced summary + stats.
#     report_channel              → openai:gpt-5.4:medium
#         Channel-level report composition for channel jobs.
#     report_compose_channel_section → openai:gpt-5.4:low
#         Per-channel section composer inside channel-report pipeline.
#
# Example 1: route the cheapest/chattiest call sites to a local model,
# keep everything else on the OpenAI defaults.
# LLM_USE_CASE_CONFIG=qa_clarification=local:qwen3-8b:off,report_map_chunks=local:qwen3-8b:off
#
# Example 2: mix providers — Anthropic for knowledge synthesis, Google
# for the long final report, OpenAI for everything else.
# LLM_USE_CASE_CONFIG=knowledge_synthesize_report=anthropic:claude-opus-4-5:medium,report_compose=google:gemini-2.5-pro

# ===== Legacy LLM knobs =====
# Legacy — use LLM_USE_CASE_CONFIG instead. Still honored for back-compat.
# LLM_PRIMARY_PROVIDER=openai
# LLM_PRIMARY_MODEL=
# LLM_MODEL=gpt-5
# LLM_FALLBACK_MODEL=gpt-4o
# LLM_MAX_CONTEXT_TOKENS=1047576
# LLM_FAST_MODEL=gpt-4.1-mini
# LLM_FAST_BASE_URL=
# LLM_FAST_API_KEY=not-needed
# LLM_ROUTE_OVERRIDES=

# ===== Jobs =====
# MAX_CONCURRENT_JOBS=5
# MAX_VIDEOS_PER_JOB=100
# DEFAULT_TRANSCRIPT_LANGUAGE=en

# ===== RAG =====
# CHUNK_SIZE=256
# CHUNK_OVERLAP=32
# RAG_TOP_K=15
# RAG_DISTANCE_THRESHOLD=0.6
# EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2

# ===== Reports =====
# REPORTS_DIR=./data/reports
# MAX_REPORT_WORDS=20000

# ===== Knowledge extraction =====
# KNOWLEDGE_EXTRACT_BATCH_TOKENS=8000
# KNOWLEDGE_MAX_TRANSCRIPT_TOKENS=60000

# ===== Auth =====
# CHANGE JWT_SECRET IN PRODUCTION — the default below is insecure and
# only safe for local dev. Use `python -c "import secrets; print(secrets.token_urlsafe(64))"`.
JWT_SECRET=
# JWT_ALGORITHM=HS256
# JWT_EXPIRY_HOURS=24
